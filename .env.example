# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Text model for plan / classification / chat diff
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Image model for generation + edits. gemini-2.5-flash-image is cheap and fast;
# gemini-3-pro-image-preview keeps architecture noticeably better (slower, pricier).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Every generated image is compared with the original by the vision model and
# regenerated if windows/doors/walls (or a kept floor) changed. 0 disables.
STRUCTURE_CHECK=1
# Extra attempts before a card is marked failed
STRUCTURE_RETRIES=2

# Public base URL (needed for auth email links on staging/prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cost brake: images per user per day before the waitlist card shows
DAILY_IMAGE_LIMIT=60
# Cards kept ready per photo
STACK_SIZE=3

# Set to 1 once Google OAuth is configured in Supabase (Auth → Providers → Google)
NEXT_PUBLIC_GOOGLE_AUTH=0
# Set to 1 once Sign in with Apple is configured in Supabase (Auth → Providers → Apple)
NEXT_PUBLIC_APPLE_AUTH=0
