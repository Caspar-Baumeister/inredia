# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Text model for plan / classification / chat diff
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Image model for generation + edits. gemini-2.5-flash-image is cheap and fast;
# gemini-3-pro-image-preview keeps architecture noticeably better (slower, pricier).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Model behind the "Extra precise" setting in Preferences (default:
# gemini-3-pro-image-preview). Slower and ~3.4x the cost, which is why one such
# image counts as 3 against the user's quota.
GEMINI_IMAGE_MODEL_PRO=
# Model that runs the structure check (yes/no answer — a cheaper one is fine).
GEMINI_VERIFY_MODEL=

# Every generated image is compared with the original by the vision model and
# regenerated if windows/doors/walls (or a kept floor) changed. 0 disables.
STRUCTURE_CHECK=1
# Extra attempts before a card is marked failed
STRUCTURE_RETRIES=2

# Public base URL (needed for auth email links on staging/prod)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Free plan: total images per user before the Pro waitlist shows
NEXT_PUBLIC_FREE_IMAGE_LIMIT=50
# Stripe (run `STRIPE_SECRET_KEY=sk_live_… node scripts/stripe-setup.mjs` once; it prints the price IDs + webhook secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOBBY_MONTHLY=
STRIPE_PRICE_HOBBY_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# 1 = let Stripe Tax compute VAT (needs Stripe Tax enabled in the dashboard)
STRIPE_AUTOMATIC_TAX=0
# Fallback cards per room when a project has no preference yet (users pick 1/3/5)
STACK_SIZE=5
# A generation stuck in "generating" longer than this is requeued and finished
# in the background (ms)
STALE_GENERATING_MS=180000
# How many other rooms get one image pre-generated in the background (0 = off)
WARM_PHOTOS=2

# Set to 1 once Sign in with Apple is configured in Supabase (Auth → Providers → Apple)
NEXT_PUBLIC_APPLE_AUTH=0
